# ═══════════════════════════════════════════════════════════════════════════
#  NEXHIRE AI — Environment Configuration Template (.env.example)
#  Copy this file to `.env` locally or configure these variables in Render.
#  NEVER commit actual secret values into GitHub.
# ═══════════════════════════════════════════════════════════════════════════

# ── General Runtime & Profiles ──────────────────────────────────────────────
APP_PROFILE=dev
TZ=UTC
PORT=8080

# ── JWT Authentication Secrets ──────────────────────────────────────────────
# Generate in terminal: openssl rand -base64 64
JWT_SECRET=your-256-bit-or-512-bit-jwt-secret-key-at-least-64-characters-long
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=nexhire-ai
JWT_AUDIENCE=nexhire-web

# ── Oracle Database (XE 21c Local / OCI Autonomous Remote) ──────────────────
# Local XE 21c default: jdbc:oracle:thin:@//localhost:1521/XEPDB2
# Autonomous Cloud:     jdbc:oracle:thin:@nexhiredb_high?TNS_ADMIN=/path/to/wallet
ORACLE_JDBC_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB2
ORACLE_USERNAME=system
ORACLE_PASSWORD=system

# ── Redis / Memurai Cache & Rate Limiting ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS=false

# ── MinIO / S3-Compatible Object Storage ────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=nexhire-app
MINIO_SECRET_KEY=nexhire-app-secret-key-32-chars-min
MINIO_REGION=us-east-1
MINIO_BUCKET_RESUMES=nexhire-resumes
MINIO_BUCKET_AVATARS=nexhire-avatars
MINIO_BUCKET_EXPORTS=nexhire-exports

# ── Google OAuth 2.0 (Google Cloud Console) ─────────────────────────────────
# Authorized redirect URIs:
# Local: http://localhost:8080/api/login/oauth2/code/google
# Production: https://<YOUR-RENDER-BACKEND-URL>/api/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}

# ── CORS Configuration (Frontend URLs) ──────────────────────────────────────
# Comma-separated allowed origins (e.g. http://localhost:3000,https://nexhire-frontend.onrender.com)
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend (Next.js 15) Environment Variables ─────────────────────────────
NEXT_PUBLIC_APP_NAME=NEXHIRE AI
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
